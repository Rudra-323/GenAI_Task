# Copy this file to .env and fill in your keys.  
OPENAI_API_KEY = your openai key here
GEMINI_API_KEY = your gemini key here
GROQ_API_KEY = your groq key here
OPENROUTER_API_KEY = your openrouter key here
# ---- Generator: answers questions (Problem 1 RAG answers, Problem 2 A/B outputs) ----
# provider = openai | gemini | groq | openrouter
GEN_PROVIDER=groq
GEN_MODEL=openai/gpt-oss-20b
GEN_TEMPERATURE=0
GEN_MAX_TOKENS=2000

# ---- Judge: grades answers. Use a DIFFERENT model family from the generator ----

JUDGE_TEMPERATURE=0
JUDGE_PROVIDER=groq
JUDGE_MODEL=qwen/qwen3.8-27b
JUDGE_MAX_TOKENS=8000
# If Gemini's free daily quota runs out, switch to e.g.:
# JUDGE_PROVIDER=openai
# JUDGE_MODEL=gpt-4o-mini

# ---- Same-family judge (only for the self-enhancement check in validate.py).
# Leave empty to reuse the GEN_* settings above.
SELFJUDGE_PROVIDER=
SELFJUDGE_MODEL=

# ---- Optional: price per 1M tokens (USD) so the scripts can print an estimated cost ----
GEN_PRICE_IN_PER_M=0
GEN_PRICE_OUT_PER_M=0
JUDGE_PRICE_IN_PER_M=0
JUDGE_PRICE_OUT_PER_M=0

# ---- Problem 1 settings (all optional, these are the defaults) ----
CHUNK_SIZE=500
CHUNK_OVERLAP=50
DEFAULT_K=5
MIN_SIMILARITY=0.25
